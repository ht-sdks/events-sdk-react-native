{
  "name": "events-sdk-react-native",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/sovran",
    "packages/core",
    "packages/plugins/*"
  ],
  "scripts": {
    "bootstrap": "yarn install && yarn example install && yarn example pods && yarn e2e install && yarn e2e pods && husky install",
    "bootstrap:ci": "yarn install && yarn e2e install && yarn e2e pods && husky install",
    "core": "yarn workspace @ht-sdks/events-sdk-react-native",
    "sovran": "yarn workspace @ht-sdks/sovran-react-native",
    "example": "yarn --cwd examples/AnalyticsReactNativeExample",
    "e2e": "yarn --cwd examples/E2E",
    "e2e-82": "yarn --cwd examples/E2E-82",
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "testAll": "yarn workspaces foreach -A -p run test --passWithNoTests",
    "clean": "yarn workspaces foreach -A -p run clean",
    "typescript": "tsc --noEmit --composite false",
    "test": "jest",
    "lint": "eslint .",
    "release": " yarn multi-semantic-release"
  },
  "devDependencies": {
    "@anolilab/multi-semantic-release": "^4.4.9",
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@changesets/cli": "^2.31.1",
    "@commitlint/config-conventional": "^18.4.2",
    "@ht-sdks/analytics-rn-shared": "workspace:^",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.1",
    "@types/react": "^19.2.0",
    "@types/uuid": "^9.0.7",
    "babel-jest": "^29.7.0",
    "commitlint": "^18.4.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.23.1",
    "rimraf": "^5.0.5",
    "semantic-release": "^25.0.9",
    "semantic-release-yarn": "^3.0.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "packageManager": "yarn@4.1.0"
}
